{
  "manifest_version": 3,
  "name": "GRM Forum Extension",
  "version": "2.1.1",
  "description": "Enhancements for the Grassroots Motorsports forum: multi-page thread search, post anchor scroll fix, and per-post copy-link buttons",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://grassrootsmotorsports.com/forum/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
